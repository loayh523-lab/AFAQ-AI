# Vercel injects VERCEL_OIDC_TOKEN for server-side AI Gateway auth on deployments.
# Optional model override: use a current model ID from the Vercel AI Gateway catalog.
AFAQ_MODEL=nvidia/nemotron-3.5-lightning-free
# Optional server-side OpenAI API key for downloading files created by Python.
# Store this as an encrypted private Vercel environment variable; never expose it to clients.
# OPENAI_API_KEY=
